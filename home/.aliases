# Shared aliases for bash and zsh

# git
alias gst='git status'
alias gss='git status --short'
alias gco='git checkout'
alias gd='git diff'
alias gmm='git pull --no-rebase --no-edit origin main'

alias ww='work -wW'
alias ws='work status'

# nvim inline diff view (gitsigns)
alias nvd='nvim +Diff'
alias nvD='nvim +DiffMain'
