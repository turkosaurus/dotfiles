{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "OTEL_METRICS_EXPORTER": "otlp"
  },
  "permissions": {
    "allow": [
      "Bash(go mod:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr get:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh-pr-threads:*)",
      "Bash(gh-pr-thread-resolve:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project list:*)",
      "Bash(dotsync -lv)",
      "Bash(ls:*)",
      "Bash(fzf:*)",
      "Bash(find:*)",
      "Bash(gh search:*)",
      "Bash(go doc:*)",
      "Bash(mise tasks:*)",
      "Read(**)",
      "mcp__plugin_skills_signoz__signoz_aggregate_logs",
      "mcp__plugin_skills_signoz__signoz_search_logs",
      "mcp__plugin_skills_signoz__signoz_get_field_values",
      "mcp__plugin_skills_signoz__signoz_get_field_keys",
      "mcp__plugin_skills_signoz__signoz_aggregate_traces",
      "mcp__plugin_skills_signoz__signoz_search_traces",
      "mcp__plugin_skills_signoz__signoz_query_metrics",
      "mcp__signoz__signoz_search_logs",
      "mcp__signoz__signoz_aggregate_logs",
      "mcp__signoz__signoz_search_traces",
      "mcp__signoz__signoz_aggregate_traces",
      "mcp__signoz__signoz_get_trace_details",
      "mcp__signoz__signoz_query_metrics",
      "mcp__signoz__signoz_list_metrics",
      "mcp__signoz__signoz_get_field_keys",
      "mcp__signoz__signoz_get_field_values",
      "mcp__signoz__signoz_list_services",
      "mcp__signoz__signoz_get_service_top_operations",
      "mcp__signoz__signoz_execute_builder_query",
      "mcp__signoz__signoz_list_dashboards",
      "mcp__signoz__signoz_list_dashboard_templates",
      "mcp__signoz__signoz_get_dashboard",
      "mcp__signoz__signoz_list_views",
      "mcp__signoz__signoz_get_view",
      "mcp__signoz__signoz_list_alerts",
      "mcp__signoz__signoz_list_alert_rules",
      "mcp__signoz__signoz_get_alert",
      "mcp__signoz__signoz_get_alert_history",
      "mcp__signoz__signoz_list_notification_channels",
      "mcp__signoz__signoz_get_notification_channel",
      "mcp__signoz__signoz_search_docs",
      "mcp__signoz__signoz_fetch_doc",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_read_canvas",
      "mcp__claude_ai_Slack__slack_read_file",
      "mcp__claude_ai_Slack__slack_read_user_profile",
      "mcp__claude_ai_Slack__slack_search_public",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_search_channels",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Slack__slack_search_emojis",
      "mcp__claude_ai_Slack__slack_list_channel_members",
      "mcp__claude_ai_Slack__slack_get_reactions"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./*.env)",
      "Read(**/.git/config)",
      "Read(**/*secret*)",
      "Read(**/id_rsa*)",
      "Read(**/*.pem)",
      "Read(* terraform*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-notify"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-notify"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Computing"
    ]
  },
  "effortLevel": "high",
  "statusLine": {
    "type": "command",
    "command": "~/bin/claude-status"
  }
}
