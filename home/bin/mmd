#!/usr/bin/env bash

# Render a mermaid diagram to PNG.
#
# Usage: mmd [input] [output]
#
# input:  path, or '-' / omitted for stdin
# output: path, '-' for stdout PNG, or omitted for inline display
#         via chafa (Kitty graphics protocol; Ghostty + Kitty).
#
# Examples:
#   echo 'graph TD; A-->B' | mmd
#   mmd diagram.mmd
#   mmd diagram.mmd diagram.png
#   mmd diagram.mmd - | pngquant - > small.png
#
# Config: $XDG_CONFIG_HOME/mmd/config.json (or ~/.config/mmd/config.json)
# is passed to mmdc as --configFile — see the mermaid.js MermaidConfig
# schema at https://mermaid.js.org/config/schema-docs/config.html

set -euo pipefail

red='\033[0;31m'
cyan='\033[0;36m'
dim='\033[2m'
reset='\033[0m'

verbose=0
timeout=30

die() {
  printf "${red}error${reset}: %s\n" "$*" >&2
  exit 1
}

info() {
  (( verbose )) || return 0
  printf "${cyan}info${reset} ${dim}%s${reset}\n" "$*" >&2
}

config_dir() {
  printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/mmd"
}

# Render mermaid source (arg $1 = source string) into PNG at path $2.
# Non-zero exit on any failure; nothing written on failure.
# Swap this body to change backends:
#   mermaid.ink (hosted, flaky, no local deps but sends diagram out):
#     b64=$(printf '%s' "$1" | base64 | tr -d '\n' | tr '+/' '-_' | tr -d '=')
#     curl -fsSL -o "$2" "https://mermaid.ink/img/${b64}?type=png"
#   kroki (self-host: docker run -d -p 8000:8000 yuzutech/kroki):
#     curl -fsSL -X POST --data-binary "$1" \
#       -H 'Content-Type: text/plain' -o "$2" http://localhost:8000/mermaid/png
mmd_render() {
  local src=$1 dest=$2 dir in err cfgdir cfg css rc=0 msg
  local args=(-b transparent)
  dir=$(mktemp -d "${TMPDIR:-/tmp}/mmd.XXXXXX")
  trap 'rm -rf "$dir"' RETURN
  in="$dir/input.mmd"
  err="$dir/err"
  printf '%s' "$src" >"$in"
  cfgdir=$(config_dir)
  cfg="$cfgdir/config.json"
  css="$cfgdir/style.css"
  if [[ -f $cfg ]]; then
    args+=(--configFile "$cfg")
    info "config: $cfg"
  fi
  if [[ -f $css ]]; then
    args+=(--cssFile "$css")
    info "css: $css"
  fi
  info "mmdc -i $in -o $dest ${args[*]}"
  timeout "$timeout" mmdc -q "${args[@]}" \
      -i "$in" -o "$dest" >/dev/null 2>"$err" || rc=$?
  if (( rc != 0 )); then
    msg=$(cat "$err")
    (( rc == 124 )) && die "mmdc timed out after ${timeout}s"
    die "mmdc failed: $msg"
  fi
}

positional=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose) verbose=1; shift ;;
    -t | --timeout) timeout="${2:-}"; shift 2 ;;
    -h | --help)
      sed -n '3,19p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --) shift; positional+=("$@"); break ;;
    -) positional+=("$1"); shift ;;
    -*) die "unknown flag: $1" ;;
    *) positional+=("$1"); shift ;;
  esac
done

(( ${#positional[@]} <= 2 )) || die "too many args (max: input output)"

input="${positional[0]:-}"
out="${positional[1]:-}"

command -v mmdc >/dev/null || \
  die "mmdc required (npm i -g @mermaid-js/mermaid-cli)"
command -v timeout >/dev/null || \
  die "timeout required (brew install coreutils)"

if [[ -z $input || $input == "-" ]]; then
  [[ -t 0 ]] && die "no input (pass a path or pipe to stdin)"
  src=$(cat)
  info "read ${#src} bytes from stdin"
else
  [[ -f $input ]] || die "not found: $input"
  src=$(cat "$input")
  info "read ${#src} bytes from $input"
fi

[[ -n $src ]] || die "empty input"

if [[ -z $out ]]; then
  command -v chafa >/dev/null ||
    die "chafa required for inline display, install or pass an output path"
  info "output: inline (chafa -f kitty)"
  png=$(mktemp "${TMPDIR:-/tmp}/mmd.XXXXXX.png")
  trap 'rm -f "$png"' EXIT
  mmd_render "$src" "$png"
  chafa -f kitty "$png"
elif [[ $out == "-" ]]; then
  info "output: stdout"
  png=$(mktemp "${TMPDIR:-/tmp}/mmd.XXXXXX.png")
  trap 'rm -f "$png"' EXIT
  mmd_render "$src" "$png"
  cat "$png"
else
  info "output: $out"
  mmd_render "$src" "$out"
fi
