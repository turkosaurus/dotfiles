#!/usr/bin/env bash

case "$(uname -s)" in
Darwin)
	if ! command -v brew &>/dev/null; then
		echo "error: homebrew required" >&2
		exit 1
	fi
	if ! brew install --cask nikitabobko/tap/aerospace; then
		echo "error: failed to install aerospace" >&2
		exit 1
	fi
	echo "note: grant accessibility permissions in System Settings > Privacy & Security"
	echo "note: caps lock is the hyper key; see bin/install/karabiner"
	;;
*)
	echo "skipping aerospace: macOS only"
	;;
esac
